(defcfg
  macos-dev-names-include (
    "Air75 V3"
    "Air75 V3-1"
    "Air75 V3 Dongle"
  )
  macos-continue-if-no-devs-found yes
  process-unmapped-keys yes
  allow-hardware-repeat false
)

(defsrc
  tab
  pgup pgdn
)

(defalias
  tab (switch
        ((input real lmet)) XX break
        () tab break
      )
  ;; ~10 scroll units spread over ~80ms; mwheel dirs swapped for macOS kanata.
  pgscroll-up (macro
    (mwheel-down 1 2) 20 (mwheel-down 1 2) 20 (mwheel-down 1 2) 20
    (mwheel-down 1 2) 20 (mwheel-down 1 2)
  )
  pgscroll-down (macro
    (mwheel-up 1 2) 20 (mwheel-up 1 2) 20 (mwheel-up 1 2) 20
    (mwheel-up 1 2) 20 (mwheel-up 1 2)
  )
)

(deflayer base
  @tab
  @pgscroll-up @pgscroll-down
)
